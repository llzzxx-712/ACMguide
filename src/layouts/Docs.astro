---
import { chapters, href, repo, dayLabel } from '../data/course';
import { isPublished, publishedLessonSlugs } from '../data/content';
import { afterJoiningChapters, afterJoiningChapterPath, afterJoiningSectionId, afterJoiningLessonPath } from '../data/after-joining';
import { isAfterJoiningPublished, publishedAfterJoiningSlugs, afterJoiningProgressId } from '../data/after-joining-content';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  section?: string;
  headings?: { depth: number; slug: string; text: string }[];
  lesson?: string;
  planned?: boolean;
}
const { title, description, section = '开始之前', headings = [], lesson, planned = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (target: string) => path === href(target).replace(/\/$/, '');
const afterJoining = path === href('after-joining') || path.startsWith(href('after-joining/'));
const progressIds = [...publishedLessonSlugs, ...publishedAfterJoiningSlugs.map(afterJoiningProgressId)];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · ACM 入门指南`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <title>{title} · ACM 入门指南</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('acmguide-theme');
        if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      } catch {}
    </script>
  </head>
  <body data-base={href()} data-published-lessons={JSON.stringify(progressIds)}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href={href()} aria-label="ACM 入门指南首页">
        <img src={href('favicon.svg')} alt="" width="30" height="30" />
        <span>ACM<span class="brand-light">guide</span><small>新生入门指南</small></span>
      </a>
      <nav class="top-nav" aria-label="主导航">
        <a class:list={{ active: isActive('') }} href={href()}>开始之前</a>
        <a class:list={{ active: !afterJoining && (isActive('roadmap/') || Boolean(lesson) || path.startsWith(href('chapter/')) || isActive('summary/')) }} href={href('roadmap/')}>招新前 · 31 天</a>
        <a class:list={{ active: afterJoining }} href={href('after-joining/')}>入队后—寒假前</a>
        <a class:list={{ active: isActive('resources/') }} href={href('resources/')}>题单与资源</a>
      </nav>
      <div class="header-tools">
        <button id="search-open" class="search-trigger" aria-label="搜索教程"><span>⌕</span><span class="search-label">搜索教程</span><kbd>Ctrl K</kbd></button>
        <a class="icon-button github-link" href={repo} target="_blank" rel="noopener noreferrer" aria-label="GitHub 仓库"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.5 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.68-3.75-1.31-3.75-1.31-.5-1.29-1.23-1.64-1.23-1.64-1-.68.08-.67.08-.67 1.1.08 1.69 1.14 1.69 1.14.98 1.7 2.58 1.21 3.21.93.1-.72.38-1.21.7-1.5-2.48-.28-5.08-1.24-5.08-5.5 0-1.22.43-2.21 1.14-2.99-.11-.28-.5-1.42.11-2.95 0 0 .93-.3 3.05 1.14A10.6 10.6 0 0 1 12 6.16c.94 0 1.88.13 2.76.38 2.11-1.43 3.04-1.14 3.04-1.14.61 1.53.22 2.67.11 2.95.71.78 1.14 1.77 1.14 2.99 0 4.27-2.61 5.22-5.1 5.5.4.34.76 1.02.76 2.06v3.09c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg></a>
        <button id="theme-toggle" class="icon-button" aria-label="切换深浅主题" title="切换深浅主题"><span class="theme-moon">☾</span><span class="theme-sun">☀</span></button>
      </div>
    </header>
    <div class="mobile-toolbar">
      <button id="menu-toggle" aria-expanded="false" aria-controls="sidebar">☰ <span>章节目录</span></button>
      <span>{section}</span>
    </div>
    <button class="sidebar-overlay" aria-label="关闭章节目录" tabindex="-1"></button>
    <div class="docs-grid">
      <aside id="sidebar" class="sidebar" aria-label="课程章节">
        <div class="sidebar-intro"><span class="small-label">从这里出发</span><a class:list={['sidebar-link', { selected: isActive('') }]} href={href()}>前言 · 写给刚入学的你</a></div>
        <div class="sidebar-separator"></div>
        <details class="course-block" open={!afterJoining}>
        <summary><span>第一板块 · 招新前<small>31 天入门学习</small></span><span class="chevron">›</span></summary>
        <a class:list={['sidebar-link', { selected: isActive('roadmap/') }]} href={href('roadmap/')}>31 天学习路线</a>
        {chapters.map(chapter => (
          <details class="chapter-group" open={chapter.id === 1 || isActive(`chapter/${chapter.id}/`) || chapter.lessons.some(item => item.slug === lesson)}>
            <summary><span class:list={['chapter-dot', `dot-${chapter.id}`]}></span><span>第{chapter.id}章 · {chapter.title}<small>{chapter.range}{!chapter.lessons.some(item => isPublished(item.slug)) ? ' · 规划中' : ''}</small></span><span class="chevron">›</span></summary>
            <div class="chapter-lessons">
              <a class:list={['sidebar-link', 'chapter-overview', { selected: isActive(`chapter/${chapter.id}/`) }]} href={href(`chapter/${chapter.id}/`)}>本章概览</a>
              {chapter.lessons.map(item => <a class:list={['sidebar-link', { selected: lesson === item.slug }]} href={href(`learn/${item.slug}/`)} aria-current={lesson === item.slug ? 'page' : undefined}><span>{item.title}</span><small>{dayLabel(item.days).replace('第 ', '').replace(' 天', 'd')}</small>{isPublished(item.slug) && <i data-lesson-dot={item.slug} aria-hidden="true"></i>}</a>)}
            </div>
          </details>
        ))}
        <a class:list={['sidebar-link', { selected: isActive('summary/') }]} href={href('summary/')}>结语 · 完成 31 天之后</a>
        </details>
        <div class="sidebar-separator"></div>
        <details class="course-block" open={afterJoining}>
          <summary><span>第二板块 · 入队后—寒假前<small>进阶学习与训练</small></span><span class="chevron">›</span></summary>
          <a class:list={['sidebar-link', { selected: isActive('after-joining/') }]} href={href('after-joining/')} aria-current={isActive('after-joining/') ? 'page' : undefined}>章节大纲总览</a>
          {afterJoiningChapters.map(chapter => <details class="chapter-group" data-after-joining-chapter={chapter.slug} open={isActive(afterJoiningChapterPath(chapter.slug)) || chapter.lessonSlugs?.some(slug => lesson === afterJoiningProgressId(slug)) || (isActive('after-joining/') && chapter.id === 1)}>
            <summary><span class:list={['chapter-dot', `dot-${(chapter.id - 1) % 9 + 1}`]}></span><span>第{chapter.id}章 · {chapter.title}<small>{chapter.lessonSlugs?.some(isAfterJoiningPublished) ? '可学习' : '规划中'}</small></span><span class="chevron">›</span></summary>
            <div class="chapter-lessons">
              <a class:list={['sidebar-link', 'chapter-overview', { selected: isActive(afterJoiningChapterPath(chapter.slug)) }]} href={href(afterJoiningChapterPath(chapter.slug))}>本章概览</a>
              {chapter.sections.map((title, index) => {const slug=chapter.lessonSlugs?.[index]; const published=isAfterJoiningPublished(slug); const selected=Boolean(slug && lesson===afterJoiningProgressId(slug)); return <a class:list={['sidebar-link',{selected}]} href={published ? href(afterJoiningLessonPath(slug!)) : `${href(afterJoiningChapterPath(chapter.slug))}#${afterJoiningSectionId(index)}`} aria-current={selected?'page':undefined}><span>{chapter.id}.{index + 1} {title}</span>{published && <i data-lesson-dot={afterJoiningProgressId(slug!)} aria-hidden="true"></i>}</a>;})}
            </div>
          </details>)}
        </details>
        <div class="sidebar-separator"></div>
        <a class:list={['sidebar-link', { selected: isActive('resources/') }]} href={href('resources/')}>↗ 题单与学习资源</a>
        <div class="progress-card"><div><span>已发布教程进度</span><strong id="progress-text">0 / {progressIds.length} 节</strong></div><progress id="course-progress" max={progressIds.length} value="0" aria-label="已完成教程节数"></progress><small>学习记录保存在当前浏览器</small></div>
      </aside>
      <main id="main-content" class="main-content" tabindex="-1">
        <div class="article-meta"><a href={href()}>ACM 入门指南</a><span>/</span><span>{section}</span>{planned && <span class="status-tag">规划中</span>}</div>
        <h1>{title}</h1>
        <p class="page-description">{description}</p>
        <div class="article-content"><slot /></div>
        {lesson && !planned && <div class="completion"><div><strong>这一节学会了吗？</strong><p>完成本节验收后，给自己记下一次进步。</p></div><button id="complete-lesson" data-lesson={lesson} aria-pressed="false">标记为已完成 <span>✓</span></button><p id="storage-status" role="status"></p></div>}
        <footer class="article-footer"><span>ACM 入门指南 · 一起写下第一行代码</span><a href={`${repo}/issues`} target="_blank" rel="noopener noreferrer">发现问题，反馈给我们 ↗</a></footer>
      </main>
      <aside class="toc" aria-label="本页目录"><div class="small-label">本页目录</div><nav>{headings.filter(item => item.depth === 2 || item.depth === 3).map(item => <a class:list={{ 'toc-sub': item.depth === 3 }} href={`#${item.slug}`}>{item.text}</a>)}</nav><div class="toc-note"><span>慢一点，也没关系。</span><p>今天比昨天多看懂一行，<br />就是在向前。</p></div></aside>
    </div>
    <dialog id="search-dialog" aria-labelledby="search-title"><div class="search-top"><label id="search-title" for="search-input">搜索教程</label><button id="search-close" class="icon-button" aria-label="关闭搜索">✕</button></div><input id="search-input" type="search" placeholder="试试：循环、数组、Hello World…" autocomplete="off" /><p id="search-status" role="status">输入关键词，查找章节和教程。</p><div id="search-results"></div><div class="search-bottom">↑ 按顺序阅读，也可以从搜索开始 <kbd>Esc 关闭</kbd></div></dialog>
    <script src="../scripts/client.ts"></script>
  </body>
</html>
