---
import Docs from '../layouts/Docs.astro';
import { href } from '../data/course';
import { afterJoiningPhases, afterJoiningChapters, afterJoiningSectionCount } from '../data/after-joining';
const headings = afterJoiningPhases.flatMap(phase => [
  { depth: 2, slug: phase.slug, text: phase.title },
  ...phase.chapters.map(chapter => ({ depth: 3, slug: chapter.slug, text: `${chapter.id}. ${chapter.title}` }))
]);
---
<Docs title="入队后—寒假前" description="补齐基础篇，系统学习进阶算法、数据结构、图论、动态规划与数学。" section="第二板块" headings={headings}>
  <div class="tags"><span class="tag">第二板块</span><span class="tag">章节大纲</span><span class="tag">{afterJoiningChapters.length} 章 · {afterJoiningSectionCount} 节规划</span></div>
  <p class="lead">完成招新前的入门学习、加入集训队后，我们继续扩充解题工具，把已经学过的知识连成体系。</p>
  <p>这一部分先补齐<a href="https://www.luogu.com.cn/training/list?type=srqc-jc" target="_blank" rel="noopener noreferrer">洛谷《深入浅出基础篇》</a>中招新阶段没有安排的高精度、二叉树、集合和图的基本应用，再围绕<a href="https://www.luogu.com.cn/training/list?type=srqc-jj" target="_blank" rel="noopener noreferrer">《深入浅出进阶篇》</a>展开。前缀和、搜索、动态规划等已学内容，会在此基础上继续深入。</p>
  <p>下面先列出章节与知识点。章节顺序按知识之间的依赖组织：先准备基础结构，再学习算法、图论和动态规划，最后补充数学与线段树进阶。</p>
  <div class="callout"><strong>继续坚持：代码是思路的实现。</strong><p>学习新算法时，先想清它解决什么问题、维护什么信息、每一步为什么成立，再用手算过程对照代码中的状态变化。</p></div>
  <nav class="outline-jumps" aria-label="大纲分组">{afterJoiningPhases.map(phase => <a href={`#${phase.slug}`}>{phase.title}</a>)}</nav>
  {afterJoiningPhases.map(phase => <section class="outline-phase" aria-labelledby={phase.slug}>
    <h2 id={phase.slug}>{phase.title}</h2>
    <p>{phase.summary}</p>
    {phase.chapters.map(chapter => <section class="outline-chapter" aria-labelledby={chapter.slug} data-outline-chapter={chapter.slug}>
      <h3 id={chapter.slug}>第{chapter.id}章 · {chapter.title}</h3>
      <p class="outline-purpose">{chapter.summary}</p>
      <ol class="outline-sections">{chapter.sections.map((title, index) => <li><span class="outline-number">{chapter.id}.{index + 1}</span><span>{title}</span></li>)}</ol>
      <p class="outline-training"><strong>对应题单：</strong>{chapter.training.map((training, index) => <Fragment>{index > 0 && '、'}<a href={`https://www.luogu.com.cn/training/${training.id}`} target="_blank" rel="noopener noreferrer">{training.title} ↗</a></Fragment>)}</p>
    </section>)}
  </section>)}
  <nav class="page-links" aria-label="两个板块之间导航"><a href={href('summary/')}><small>← 回顾第一板块</small>31 天学习总结</a><a href={href('resources/')}><small>学习资源 →</small>题单与学习资源</a></nav>
</Docs>
